# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NANO_BANANA_API_KEY: Optional dedicated Nano Banana background removal API key
# If provided, requests will be routed to https://api.nano-banana.com/v1/remove-background
NANO_BANANA_API_KEY="MY_NANO_BANANA_API_KEY"

# OPENAI_API_KEY: Optional OpenAI API key for ChatGPT image editing
OPENAI_API_KEY="MY_OPENAI_API_KEY"
# OPENAI_IMAGE_MODEL: OpenAI model for ChatGPT image edits (default: gpt-image-2.5-flare)
OPENAI_IMAGE_MODEL="gpt-image-2.5-flare"

# AI_MODEL: Google Gemini model for Nano Banana edits (default: gemini-2.5-flash-image)
AI_MODEL="gemini-2.5-flash-image"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
